# Public URL of the deployed app; used to build password-reset links.
APP_URL=https://your-app.onrender.com

# Supabase PostgreSQL Session Pooler connection string. Keep this secret.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# SMTP provider credentials for password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=M-CONNECT <no-reply@example.com>
